{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "kisanq-farmer",
      "public": "dist",
      "_comment": "kisanq.apk is kept in dist/ for reference but never uploaded: Firebase Hosting rejects executables on the Spark plan, which fails the whole deploy.",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "kisanq.apk"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "kisanq",
      "public": "website",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "README.md",
        "make-qr.py"
      ]
    }
  ]
}
