rules_version = '2';

// Access model, per docs/KisanQ_Missing_Details_Polish.md section 7:
//   - A farmer can only read/write their own documents in farmers/, bookings/, crops/
//     (matched by their own farmerId).
//   - An operator can only write to queue/, procurement/ documents belonging to bookings
//     at their assigned centre.
//   - Admin has read access across all collections, write access only to centres/ management.
//
// Identity model: neither the mocked Aadhaar+OTP flow nor the mocked Staff ID + PIN login ever
// mints a real auth token or custom claim (no Cloud Function exists to do that), but these
// rules still need *some* real request.auth to scope access by role instead of trusting the
// client UI. So every device signs in with Firebase Anonymous Auth on launch (invisible to the
// user):
//   - A farmer's own uid becomes their farmerId once Aadhaar+OTP succeeds.
//   - A staff member's device "claims" its identity by writing staffSessions/{uid}, which these
//     rules cross-check against the authoritative staff/{staffId} doc (role, assignedCentreId)
//     before trusting it — see the staffSessions match block below and
//     src/context/OperatorContext.tsx. This stops a session from claiming a role/centre a real
//     staff record doesn't have, but it can't stop a technically-savvy client from skipping the
//     PIN-entry UI and writing a session directly if they already know/guess a valid staffId —
//     genuinely closing that gap would need a Cloud Function to verify the PIN server-side
//     before minting the session, which is out of scope for this prototype (documented
//     limitation, not silently pretended away — consistent with the Cross-Questions doc).
//
// Second, separate limitation, confirmed empirically while wiring the Operator screens:
// Cloud Firestore CANNOT secure a *list/collection query* with a rule that depends on a get()
// call — get()-based checks only work for single-document get()/write requests. Since
// isOperatorForCentre()/isAdmin()/isOperatorForBooking() all call get() (there's no other way to look up
// a role without a real custom claim, which again needs a Cloud Function we don't have), any
// collection that the app needs to *query* — not just fetch single documents from — has its
// read rule relaxed to "any signed-in device" below, with a comment at each spot. Writes and
// single-document reads keep the real get()-based role checks; only list-query reads on
// bookings/, crops/, queue/, procurement/, payments/ and notifications/ are affected
// (objections/ avoids it with deterministic doc ids — see its match block). This is a real,
// deliberate gap for the prototype, not an oversight — the honest fix is a Cloud Function
// minting real custom claims.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(farmerId) {
      return isSignedIn() && request.auth.uid == farmerId;
    }

    function mySession() {
      return get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && mySession().role == 'admin';
    }

    function isOperatorForCentre(centreId) {
      return isSignedIn() && mySession().role == 'operator' && mySession().assignedCentreId == centreId;
    }

    function isStaff() {
      return isSignedIn() && (mySession().role == 'operator' || mySession().role == 'admin');
    }

    function bookingCentreId(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data.centreId;
    }

    function isOperatorForBooking(bookingId) {
      return isOperatorForCentre(bookingCentreId(bookingId));
    }

    match /farmers/{farmerId} {
      // isStaff(), not just isAdmin(): an operator legitimately needs to read any farmer's
      // name during check-in (this is a single-document get, so the get()-in-list-queries
      // limitation noted above doesn't apply here).
      allow read: if isOwner(farmerId) || isStaff();
      allow write: if isOwner(farmerId) || isAdmin();
    }

    match /identityVerification/{farmerId} {
      allow read: if isOwner(farmerId) || isAdmin();
      allow write: if isOwner(farmerId);
    }

    match /crops/{cropId} {
      // Relaxed to isSignedIn() for read — see the get()-in-list-queries note above.
      // listCropsForFarmer() and the operator's future crop lookups both query this collection.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.farmerId;
      allow update, delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.farmerId);
    }

    match /centres/{centreId} {
      allow read: if true; // centre list is needed pre-login for slot browsing
      allow write: if isAdmin();
    }

    match /commodities/{commodityId} {
      // The runtime commodity master. Read-open for the same reason centres/ is: the farmer's
      // crop picker is reached before a farmer means anything as an identity, and this list is
      // public policy information, not anyone's data. Only an admin adds or edits a commodity
      // (Admin Settings), and there is deliberately no delete path — a commodity is deactivated
      // rather than removed, since bookings, capacity rows and procurement records key on its
      // id and would be left dangling.
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /centreCropCapacity/{capacityId} {
      // Daily Buying Capacity feature, tracked per crop per centre (a mandi can legitimately be
      // buying more than one crop the same day) — same read-openness reasoning as centres/
      // above, since Centre Selection needs this before a farmer has "signed in" as themselves
      // in any meaningful sense.
      allow read: if true;
      // Only an admin creates/deletes a (centre, crop) capacity entry — this is the deliberate,
      // manual "start tracking this crop's capacity" action (addCentreCropCapacity()).
      allow create, delete: if isAdmin();
      // submitQualityCheck()'s Accept step decrements remainingCapacityQuintals by the accepted
      // booking's actual weighed quantity, in the same transaction as the existing
      // procurement/booking/queue writes — same idea as the slots.bookedCount pattern above,
      // but since the decrement amount varies per booking (not a fixed ±1), this can only check
      // that the write is same-centre-operator, touches nothing but this one field, and moves
      // the number down, never up — raising it back is a separate, deliberate admin-only action
      // (increaseCentreCropCapacity()).
      allow update: if isAdmin()
        || (isOperatorForCentre(resource.data.centreId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["remainingCapacityQuintals"])
            && request.resource.data.remainingCapacityQuintals < resource.data.remainingCapacityQuintals);
    }

    match /slots/{slotId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || isOperatorForCentre(resource.data.centreId)
        // A farmer booking a slot bumps its bookedCount by exactly 1 (createBooking()'s
        // transaction); cancelBooking() bumps it back down by exactly 1 — these are the only
        // two slot writes a farmer ever needs to make.
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["bookedCount"])
            && (request.resource.data.bookedCount == resource.data.bookedCount + 1
                || request.resource.data.bookedCount == resource.data.bookedCount - 1));
    }

    match /tokenCounters/{counterId} {
      // Not farmer/admin/operator data — just an internal daily sequence per centre, read then
      // bumped inside the same transaction that creates a booking (the transaction's own
      // tx.get() is still subject to this read rule, so it can't be `if false`). Nothing
      // sensitive lives here, so any signed-in device may read/write it.
      allow read, write: if isSignedIn();
    }

    match /queuePositionCounters/{counterId} {
      // Same pattern as tokenCounters, read+bumped inside the check-in transaction.
      allow read, write: if isSignedIn();
    }

    match /bookings/{bookingId} {
      // Relaxed to isSignedIn() for read — see the get()-in-list-queries note above.
      // getActiveBookingForFarmer() and the operator's findCheckInCandidate() both query this
      // collection (by farmerId and by centreId+tokenNumber respectively).
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.farmerId;
      allow update: if isAdmin()
        || isOperatorForCentre(resource.data.centreId)
        // cancelBooking(): a farmer may cancel only their own booking, only while it's still
        // "booked" (not yet checked in — an operator has to handle anything past that point),
        // and only by flipping status to "cancelled" — nothing else about the booking.
        || (isSignedIn()
            && request.auth.uid == resource.data.farmerId
            && resource.data.status == "booked"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
            && request.resource.data.status == "cancelled");
    }

    match /queue/{queueId} {
      // Relaxed to isSignedIn() for read — see the get()-in-list-queries note above.
      // listenQueueForCentre() queries this collection by centreId for the Live Queue screen.
      allow read: if isSignedIn();
      allow create: if isAdmin() || isOperatorForCentre(request.resource.data.centreId);
      allow update: if isAdmin() || isOperatorForCentre(resource.data.centreId);
    }

    match /procurement/{procurementId} {
      // Relaxed to isSignedIn() for read — see the get()-in-list-queries note above.
      // The farmer's Procurement Status screen queries this collection by bookingId in real
      // time (onSnapshot).
      allow read: if isSignedIn();
      // Weighing/Quality-check screens (build order step 5): scoped via the booking's own
      // centreId rather than a centreId field on the procurement doc itself, since the doc
      // doesn't carry one.
      allow create: if isAdmin() || isOperatorForBooking(request.resource.data.bookingId);
      allow update: if isAdmin() || isOperatorForBooking(resource.data.bookingId);
    }

    match /payments/{paymentId} {
      // Relaxed to isSignedIn() for read — see the get()-in-list-queries note above. The
      // farmer's Procurement Status screen queries this collection by procurementId in real
      // time (onSnapshot) for the "Payment" tick.
      allow read: if isSignedIn();
      // Create is open to any staff, not just admin: submitQualityCheck() raises the
      // *simulated* payment doc inside the operator's own quality-check transaction, so the
      // amount reaches the farmer's tracker at the same instant as the grade and breakdown. No
      // real money moves (CLAUDE.md rule 6) — the doc is always created at the first stage,
      // "quality_accepted". Update/delete stay admin-only: only an admin moves a payment through
      // J-Form generated -> Payment sent -> Credited (advancePaymentStage()), and an operator
      // can't retroactively rewrite an amount after the farmer has seen it, which is exactly
      // the fraud the tracker exists to expose.
      allow create: if isStaff() && request.resource.data.status == "quality_accepted";
      allow update, delete: if isAdmin();
    }

    match /objections/{objectionId} {
      // A farmer disputing a recorded weight or quality/moisture result. Doc id is
      // {bookingId}_{stage} (one objection per booking per stage), so the farmer reads their own
      // objection with single-document gets — never a list query — which is what lets this read
      // rule stay owner-scoped without hitting the get()-in-list-queries limitation above.
      // `resource == null` lets the farmer's listener on a not-yet-created objection succeed
      // (it reveals nothing); the owner check short-circuits before isStaff() is evaluated.
      allow get: if isSignedIn()
        && (resource == null || resource.data.farmerId == request.auth.uid || isStaff());
      // Unfiltered list for the Admin Objections screen — isStaff() doesn't depend on
      // resource.data, so it's securable as a list rule (see CLAUDE.md's admin-query note).
      allow list: if isStaff();
      // Farmer creates only for their own booking (checked against the real booking doc, a
      // single-document get() — fine in a write rule), only as "open", only under the
      // deterministic id. A second objection on the same stage would be an update, which only
      // an admin may do — so a farmer can't overwrite or re-open anything.
      allow create: if isSignedIn()
        && request.resource.data.farmerId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.farmerId == request.auth.uid
        && request.resource.data.centreId == bookingCentreId(request.resource.data.bookingId)
        && request.resource.data.stage in ["weighing", "quality"]
        && objectionId == request.resource.data.bookingId + "_" + request.resource.data.stage
        && request.resource.data.reason in ["weight", "quality", "other"]
        && request.resource.data.status == "open";
      // Only an admin changes status (open -> resolved), and nothing else about the objection.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "resolvedAt", "resolvedByStaffId"])
        && request.resource.data.status == "resolved";
      allow delete: if false;
    }

    match /smsLog/{smsId} {
      // Simulated SMS audit trail (src/services/sms.ts). Every farmer notification is raised by
      // a staff action, so only staff write here; only an admin reads it (Admin SMS Log screen —
      // an unfiltered list, securable since isAdmin() doesn't depend on resource.data). Entries
      // are append-only: status must be "simulated" until a real gateway is integrated.
      allow create: if isStaff() && request.resource.data.status == "simulated";
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      // Relaxed to isSignedIn() for read — see the get()-in-list-queries note above.
      // listenNotifications() queries this collection by farmerId in real time (onSnapshot) for
      // the farmer's Notifications screen; a single-doc get() could still use isOwner(), but the
      // list query this screen actually runs can't be secured by a resource.data-dependent check.
      allow read: if isSignedIn();
      // Only staff create these today (callNextInQueue/recordWeighing/submitQualityCheck all run
      // under an operator/admin session) — tightened from isSignedIn() now that notifications are
      // actually readable by farmers, since an unscoped create let any signed-in farmer forge a
      // notification claiming to be from the system for a different farmerId.
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /staff/{staffId} {
      // get (not list): open to any signed-in device, since the login screen
      // (OperatorContext.tsx's getDoc-by-staffId) and claimedMatchesRealStaff()'s internal
      // get() above both need to look up a single staff record by id *before* any staffSession
      // exists — there's no way to scope this to "only staff" without breaking login itself.
      // list is a different story: nothing in the app ever queries the whole staff collection,
      // only single-document get()s by a known/guessed staffId — so restricting list to admin
      // closes off a real gap (any signed-in farmer's phone could otherwise run one
      // getDocs(collection(db,'staff')) and dump every operator's pinHash across every centre
      // in a single call). This doesn't fully close the door — a client that already
      // knows/guesses one staffId can still get() that one doc — but it removes the
      // whole-directory harvesting risk, which get()-based role checks can't do for isAdmin()
      // either (see the get()-in-list-queries note above): isAdmin() itself needs isSignedIn(),
      // so admin's own list access here relies on the staffSessions/staff doc chain already
      // being trusted, not on a stronger check being possible.
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /staffSessions/{uid} {
      function claimedMatchesRealStaff() {
        let staff = get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data;
        return staff.role == request.resource.data.role
          && staff.assignedCentreId == request.resource.data.assignedCentreId;
      }

      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid && claimedMatchesRealStaff();
      allow delete: if isSignedIn() && request.auth.uid == uid; // logout
    }
  }
}
