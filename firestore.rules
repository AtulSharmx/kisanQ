rules_version = '2';

// Access model, per docs/KisanQ_Missing_Details_Polish.md section 7:
//   - A farmer can only read/write their own documents in farmers/, bookings/, crops/
//     (matched by their own farmerId).
//   - An operator can only write to queue/, procurement/ documents belonging to bookings
//     at their assigned centre.
//   - Admin has read access across all collections, write access only to centres/ management.
//
// Identity model: the mocked Aadhaar+OTP flow (Master Spec sec. 2) never touches a real UIDAI
// API and never mints a custom token, but these rules still need *some* real request.auth to
// scope access by role instead of trusting the client UI. So the app signs the device in with
// Firebase Anonymous Auth right at launch (invisible to the user) and uses that uid as the
// farmerId once Aadhaar+OTP succeeds — see src/context/FarmerContext.tsx. Staff (operator/
// admin) sign-in is a later build step; until a Cloud Function mints their `role`/`centreId`
// custom claims on staff login, isAdmin()/isOperatorForCentre() below will simply never match,
// which is intentionally fail-closed rather than fail-open.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(farmerId) {
      return isSignedIn() && request.auth.uid == farmerId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOperatorForCentre(centreId) {
      return isSignedIn()
        && request.auth.token.role == 'operator'
        && request.auth.token.centreId == centreId;
    }

    function bookingFarmerId(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data.farmerId;
    }

    function ownsBooking(bookingId) {
      return isSignedIn() && request.auth.uid == bookingFarmerId(bookingId);
    }

    function ownsProcurement(procurementId) {
      let bookingId = get(/databases/$(database)/documents/procurement/$(procurementId)).data.bookingId;
      return ownsBooking(bookingId);
    }

    match /farmers/{farmerId} {
      allow read, write: if isOwner(farmerId) || isAdmin();
    }

    match /identityVerification/{farmerId} {
      allow read: if isOwner(farmerId) || isAdmin();
      allow write: if isOwner(farmerId);
    }

    match /crops/{cropId} {
      allow read, write: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.farmerId);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.farmerId;
    }

    match /centres/{centreId} {
      allow read: if true; // centre list is needed pre-login for slot browsing
      allow write: if isAdmin();
    }

    match /slots/{slotId} {
      allow read: if true;
      allow write: if isAdmin() || isOperatorForCentre(resource.data.centreId);
    }

    match /tokenCounters/{counterId} {
      // Not farmer/admin/operator data — just an internal daily sequence per centre, bumped
      // inside the same transaction that creates a booking. Anyone signed in may increment it,
      // but there is nothing sensitive to read here.
      allow read: if false;
      allow write: if isSignedIn();
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.farmerId)
        || isOperatorForCentre(resource.data.centreId);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.farmerId;
      allow update: if isAdmin() || isOperatorForCentre(resource.data.centreId);
    }

    match /queue/{queueId} {
      allow read: if isAdmin() || isOperatorForCentre(resource.data.centreId)
        || ownsBooking(resource.data.bookingId);
      allow write: if isAdmin() || isOperatorForCentre(resource.data.centreId)
        || isOperatorForCentre(request.resource.data.centreId);
    }

    match /procurement/{procurementId} {
      allow read: if isAdmin() || ownsBooking(resource.data.bookingId);
      allow write: if isAdmin(); // narrowed to assigned-centre operators once procurement
                                  // docs carry a centreId field
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || ownsProcurement(resource.data.procurementId);
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || isOwner(resource.data.farmerId);
      allow write: if isAdmin();
    }

    match /staff/{staffId} {
      allow read, write: if isAdmin();
    }
  }
}
